#!/usr/bin/env bats
# pr-footer.sh against a stubbed gh (#261): the harness-added "_Generated by [Claude Code](...)_"
# footer is stripped from a cloud PR's body over REST, only when there is one, and read back.

setup() {
  load test_helper
  SCRIPTS="$(cd "$(dirname "$BATS_TEST_FILENAME")" && pwd)"
  FX="$BATS_TEST_TMPDIR/fx"; mkdir -p "$FX" "$BATS_TEST_TMPDIR/bin"
  export FX PATH="$BATS_TEST_TMPDIR/bin:$PATH" ORCHESTRATE_STATE_DIR="$BATS_TEST_TMPDIR/state"
  export ORCHESTRATE_NOW=1790510400
  unset ORCHESTRATE_PR_FOOTER_POLICY ORCHESTRATE_PR_FOOTER_PATTERN
  # pr-N.json is PR N as REST returns it; a PATCH rewrites its body (patch-fails: refused,
  # patch-noop: accepted but the body stays). read-fails-N: reads of PR N fail; list-fails: the list.
  cat >"$BATS_TEST_TMPDIR/bin/gh" <<'STUB'
#!/usr/bin/env bash
all="$*"; all=${all% --include}
echo "$all" >>"$FX/calls"
case "$all" in
  "api -X PATCH repos/o/r/pulls/"*)
    n=${all#api -X PATCH repos/o/r/pulls/}; n=${n%% *}
    f=${all##* --input }
    cp "$f" "$FX/patch-$n.json"
    [ ! -f "$FX/patch-fails" ] || { echo "gh: Validation Failed (HTTP 422)" >&2; exit 1; }
    [ -f "$FX/patch-noop" ] || jq --slurpfile p "$f" '.body = $p[0].body' "$FX/pr-$n.json" >"$FX/pr-$n.tmp"
    [ -f "$FX/patch-noop" ] || mv "$FX/pr-$n.tmp" "$FX/pr-$n.json"
    echo '{}' ;;
  "api --paginate repos/o/r/pulls?state=open&per_page=100")
    [ ! -f "$FX/list-fails" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
    jq -s . "$FX"/pr-*.json ;;
  "api repos/o/r/pulls/"*)
    n=${all#api repos/o/r/pulls/}
    [ ! -f "$FX/read-fails-$n" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
    cat "$FX/pr-$n.json" ;;
  *) echo "unexpected gh call: $*" >&2; exit 9 ;;
esac
STUB
  chmod +x "$BATS_TEST_TMPDIR/bin/gh"
}

FOOTER='_Generated by [Claude Code](https://claude.ai/code/session_01abc)_'
pr() { # number body [head ref]
  jq -n --argjson n "$1" --arg b "$2" --arg h "${3:-work/$1-auto}" '{number: $n, body: $b, head: {ref: $h}}' >"$FX/pr-$1.json"
}
body() { jq -r .body "$FX/pr-$1.json"; }
patches() { grep -c -- '-X PATCH' "$FX/calls" 2>/dev/null || true; }
footer() { "$SCRIPTS/pr-footer.sh" --repo o/r "$@"; }

@test "a trailing footer and the rule above it are stripped over REST and read back" {
  pr 7 "$(printf 'Closes #7\n\nSummary of the change.\n\n---\n\n%s' "$FOOTER")"
  run footer --pr 7
  [ "$status" -eq 0 ]
  [ "$output" = "stripped #7" ]
  [ "$(body 7)" = "$(printf 'Closes #7\n\nSummary of the change.')" ]
  [ "$(patches)" -eq 1 ]
  [[ "$(cat "$ORCHESTRATE_STATE_DIR/o__r/hygiene-actions.log")" == *"pr-footer"*"pr=7"*"stripped"* ]]
}

@test "a body with no footer is left alone: no write" {
  pr 8 "$(printf 'Closes #8\n\n---\n\nNotes.')"
  run footer --pr 8
  [ "$status" -eq 0 ]
  [ "$output" = "clean #8" ]
  [ "$(patches)" -eq 0 ]
  [ "$(body 8)" = "$(printf 'Closes #8\n\n---\n\nNotes.')" ]
}

@test "a footer followed by trailing whitespace and CRLF line ends is still stripped" {
  pr 9 "$(printf 'Closes #9\r\n\r\n---\r\n%s  \t\r\n\r\n   \n' "$FOOTER")"
  run footer --pr 9
  [ "$status" -eq 0 ]
  [ "$output" = "stripped #9" ]
  [ "$(body 9)" = "$(printf 'Closes #9\r')" ]
}

@test "a footer line in the middle of the body is not touched, and a rule with no footer stays" {
  pr 10 "$(printf 'Quoting the bug:\n%s\n\nMore text.\n\n---' "$FOOTER")"
  run footer --pr 10
  [ "$status" -eq 0 ]
  [ "$output" = "clean #10" ]
  [ "$(patches)" -eq 0 ]
}

@test "a body that is only the footer becomes empty; a null body is clean" {
  pr 11 "$FOOTER"
  jq -n '{number: 12, body: null, head: {ref: "work/12-auto"}}' >"$FX/pr-12.json"
  run footer --pr 11
  [ "$output" = "stripped #11" ]
  [ "$(body 11)" = "" ]
  run footer --pr 12
  [ "$output" = "clean #12" ]
}

@test "--dry-run names the PR and writes nothing" {
  pr 7 "$(printf 'Body\n\n%s' "$FOOTER")"
  run footer --pr 7 --dry-run
  [ "$status" -eq 0 ]
  [ "$output" = "would strip #7" ]
  [ "$(patches)" -eq 0 ]
}

@test "--cloud checks only open PRs on cloud-session branches, from one list read" {
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  pr 8 "B"
  pr 9 "$(printf 'C\n\n%s' "$FOOTER")" feature/local-lane
  run footer --cloud
  [ "$status" -eq 0 ]
  [ "$output" = "$(printf 'stripped #7\nclean #8')" ]
  [ "$(body 9)" = "$(printf 'C\n\n%s' "$FOOTER")" ]
  [ "$(grep -c 'pulls?state=open' "$FX/calls")" -eq 1 ]
  run footer --cloud --head '^feature/'
  [ "$output" = "stripped #9" ]
}

@test "policy keep, or a brief without No attribution under auto, makes no GitHub call" {
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  run footer --pr 7 --policy keep
  [ "$status" -eq 0 ]
  [[ "$output" == "skipped: policy keep (--policy keep)" ]]
  printf 'Attribution lines are welcome.\n' >"$BATS_TEST_TMPDIR/brief.md"
  run footer --pr 7 --brief "$BATS_TEST_TMPDIR/brief.md"
  [[ "$output" == *"does not say No attribution"* ]]
  mkdir -p "$ORCHESTRATE_STATE_DIR/o__r"
  printf 'Custom brief.\n' >"$ORCHESTRATE_STATE_DIR/o__r/cloud-brief.md"
  run footer --pr 7
  [[ "$output" == *"cloud-brief.md does not say No attribution"* ]]
  ORCHESTRATE_PR_FOOTER_POLICY=keep run footer --pr 7
  [[ "$output" == "skipped: policy keep"* ]]
  run footer --pr 7 --brief "$BATS_TEST_TMPDIR/missing.md"
  [[ "$output" == *"not found"* ]]
  [ ! -f "$FX/calls" ]
}

@test "auto strips under the default brief and under a brief that says No attribution; strip ignores it" {
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  run footer --pr 7
  [ "$output" = "stripped #7" ]
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  printf 'no ATTRIBUTION lines.\n' >"$BATS_TEST_TMPDIR/brief.md"
  run footer --pr 7 --brief "$BATS_TEST_TMPDIR/brief.md"
  [ "$output" = "stripped #7" ]
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  printf 'Attribution welcome.\n' >"$BATS_TEST_TMPDIR/brief.md"
  run footer --pr 7 --policy strip --brief "$BATS_TEST_TMPDIR/brief.md"
  [ "$output" = "stripped #7" ]
}

@test "--pattern and ORCHESTRATE_PR_FOOTER_PATTERN choose the footer line" {
  pr 7 "$(printf 'A\n\nMade by a bot')"
  run footer --pr 7
  [ "$output" = "clean #7" ]
  run footer --pr 7 --pattern '^Made by a bot$'
  [ "$output" = "stripped #7" ]
  pr 7 "$(printf 'A\n\nMade by a bot')"
  ORCHESTRATE_PR_FOOTER_PATTERN='bot$' run footer --pr 7
  [ "$output" = "stripped #7" ]
}

@test "a refused or ineffective write is exit 5 and logs nothing; an unreadable PR or list is exit 7" {
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  touch "$FX/patch-fails"
  run footer --pr 7
  [ "$status" -eq 5 ]
  [ "$output" = "strip failed #7 (exit 1)" ]
  rm "$FX/patch-fails"; touch "$FX/patch-noop"
  run footer --pr 7
  [ "$status" -eq 5 ]
  [ "$output" = "strip failed #7 (exit 0)" ]
  [ ! -f "$ORCHESTRATE_STATE_DIR/o__r/hygiene-actions.log" ]
  touch "$FX/read-fails-8"
  run footer --pr 8
  [ "$status" -eq 7 ]
  [[ "$output" == "unverified #8: the PR could not be read" ]]
  touch "$FX/list-fails"
  run footer --cloud
  [ "$status" -eq 7 ]
  [[ "$output" == "unverified: the open PR list could not be read" ]]
}

@test "a write that cannot be read back is unverified (exit 9), and outranks a failed one" {
  pr 7 "$(printf 'A\n\n%s' "$FOOTER")"
  pr 8 "$(printf 'B\n\n%s' "$FOOTER")"
  # The list read serves both; then PR 7's read-back fails (reads of 7 fail only after its PATCH)
  # and PR 8's write is refused.
  sed -i.bak 's#cp "$f" "$FX/patch-$n.json"#cp "$f" "$FX/patch-$n.json"; [ "$n" != 7 ] || touch "$FX/read-fails-7"; [ "$n" != 8 ] || touch "$FX/patch-fails"#' "$BATS_TEST_TMPDIR/bin/gh"
  run footer --cloud
  [ "$status" -eq 9 ]
  [[ "$output" == *"unverified #7: footer strip sent (exit 0) but the body was not read back; rerun"* ]]
  [[ "$output" == *"strip failed #8 (exit 1)"* ]]
}

@test "usage: --pr or --cloud (not both), a numeric PR, a known policy, a non-empty pattern" {
  run footer
  [ "$status" -eq 2 ]
  run footer --pr 7 --cloud
  [ "$status" -eq 2 ]
  run footer --pr x
  [ "$status" -eq 2 ]
  run footer --pr 7 --policy sometimes
  [ "$status" -eq 2 ]
  run footer --pr 7 --pattern ''
  [ "$status" -eq 2 ]
  [ ! -f "$FX/calls" ]
}
